+static_assert(sizeof(UVM_TEST_CASK_PHYSICAL_CE_PARAMS)==144,"physical CE ABI");
+#elif !defined(__KERNEL__)
+_Static_assert(sizeof(UVM_TEST_CASK_PHYSICAL_CE_PARAMS)==144,"physical CE ABI");
+#endif
