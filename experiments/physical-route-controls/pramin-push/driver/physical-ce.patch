+        phase = "initialize_source";
+        for (i = 0; i < PAGE_SIZE / sizeof(*cpu); ++i)
+            WRITE_ONCE(cpu[i], cask_pramin_pattern(index, mode, i, true));
+        clflush_cache_range(cpu, PAGE_SIZE);
+        wmb();
